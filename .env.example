PORT=3000

# Week 2: Prisma's connection string for MySQL. Matches the `mysql` service in
# docker-compose.yml (run `docker compose up -d mysql`) — change host/user/
# password/db name here if you're pointing at a MySQL instance running some
# other way.
DATABASE_URL="mysql://root:root@localhost:3306/support_desk"

# Week 4: signs and verifies this API's JWTs. Never reuse this value anywhere
# real — generate your own with, e.g., `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="1d"

# Week 5: nodemailer sends here instead of a real mail server. Matches the
# `mailpit` service in docker-compose.yml (run `docker compose up -d mailpit`)
# — read what was "sent" at http://localhost:8025, nothing leaves your machine.
MAIL_HOST="localhost"
MAIL_PORT=1025
MAIL_FROM="Support Desk <support@example.test>"
